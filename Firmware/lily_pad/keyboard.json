{
    "manufacturer": "Alloy",
    "keyboard_name": "lily_pad",
    "maintainer": "Alloy",
    "bootloader": "rp2040",
    "diode_direction": "COL2ROW",
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true
    },
    "matrix_pins": {
        "cols": ["GP29", "GP6", "GP7"],
        "rows": ["GP26", "GP27", "GP28"]
    },
    "encoder": {
        "rotary": [
            {
                "pin_a": "GP4",
                "pin_b": "GP2"
            }
        ]
    },

    "processor": "RP2040",
    "url": "https://github.com/Alloy-MVP/Lily-pad/tree/main/Firmware",
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0000",
        "vid": "0xFEED"
    },
    "layouts": {
        "LAYOUT_ortho_3x3": {
            "layout": [
                {"matrix": [0, 0], "x": 0, "y": 0},
                {"matrix": [0, 1], "x": 1, "y": 0},

                {"matrix": [1, 0], "x": 0, "y": 1},
                {"matrix": [1, 1], "x": 1, "y": 1},

                {"matrix": [2, 0], "x": 0, "y": 2},
                {"matrix": [2, 1], "x": 1, "y": 2},
                {"matrix": [2, 2], "x": 2, "y": 2}
            ]
        }
    }
}